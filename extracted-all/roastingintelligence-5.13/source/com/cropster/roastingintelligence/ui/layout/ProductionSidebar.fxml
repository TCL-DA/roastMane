<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import org.girod.javafx.svgimage.SVGImage?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.input.KeyCodeCombination?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Text?>
<?import com.cropster.roastingintelligence.ui.components.HintsButton?>
<?import com.cropster.roastingintelligence.ui.components.HintsFooterElement?>
<?import com.cropster.roastingintelligence.ui.components.KeyCodeCombinationLabel?>
<?import com.cropster.roastingintelligence.ui.components.LineBreak?>
<?import com.cropster.roastingintelligence.ui.components.RadioToggleButton?>
<?import com.cropster.roastingintelligence.ui.components.Tooltip?>
<?import com.cropster.roastingintelligence.ui.list.EmptyStateList?>

<fx:root type="BorderPane" styleClass="pane--elevated" xmlns:fx="http://javafx.com/fxml">
    <fx:define>
        <Insets fx:id="CONTENT_MARGIN" top="-8"/>
        <Insets fx:id="FILTER_MARGIN" right="9.5" left="9.5"/>
        <SVGImage fx:id="ICON_CUSTOMIZE" icon="CUSTOMIZE"/>
        <SVGImage fx:id="ICON_HINT_SEE_MORE" icon="SEE_MORE"/>
        <SVGImage fx:id="ICON_SEE_MORE_BATCH" icon="SEE_MORE"/>
        <SVGImage fx:id="ICON_SEE_MORE_BLEND" icon="SEE_MORE"/>
        <SVGImage fx:id="ICON_SIDEBAR" icon="SIDEBAR" />
        <SVGImage fx:id="ICON_SIDEBAR_DETACHED" icon="SIDEBAR_DETACHED" />
        <ToggleGroup fx:id="productionToggleGroup"/>
        <ToggleGroup fx:id="roastFilterGroup"/>
    </fx:define>
    <top>
        <VBox>
            <styleClass>
                <String fx:value="padding-sides--small" />
                <String fx:value="spacing--default" />
            </styleClass>
            <HBox alignment="CENTER_LEFT" styleClass="spacing--small">
                <Label text="${controller.title}" maxWidth="Infinity" styleClass="heading" HBox.hgrow="ALWAYS">
                    <tooltip>
                        <Tooltip text="${controller.title}"/>
                    </tooltip>
                </Label>
                <HintsButton arrowLocation="LEFT_TOP" small="true" title="%About this sidebar">
                    <Text text="%Synchronize your production schedule from our web platform."/>
                    <LineBreak/>
                    <Text text="%Once batches are roasted, edit their information, print their roast labels, mark them as reference and more."/>
                    <footer>
                        <Label styleClass="hints-footer-title" text="%Actions, usage and keyboard shortcuts"/>
                        <HintsFooterElement description="%More options" elementGraphic="$ICON_HINT_SEE_MORE"/>
                        <KeyCodeCombinationLabel fx:id="doubleClickKeyCodeCombinationLabel" text="%Edit an entry"/>
                        <KeyCodeCombinationLabel fx:id="clickKeyCodeCombinationLabel" text="%Select/deselect a single entry"/>
                        <KeyCodeCombinationLabel fx:id="upKeyCodeCombinationLabel" text="%Select multiple adjacent entries">
                            <keyCodeCombination>
                                <KeyCodeCombination code="UP" shift="UP" control="UP" alt="UP" meta="UP" shortcut="DOWN"/>
                            </keyCodeCombination>
                        </KeyCodeCombinationLabel>
                        <KeyCodeCombinationLabel fx:id="downKeyCodeCombinationLabel">
                            <keyCodeCombination>
                                <KeyCodeCombination code="DOWN" shift="UP" control="UP" alt="UP" meta="UP" shortcut="DOWN"/>
                            </keyCodeCombination>
                        </KeyCodeCombinationLabel>
                    </footer>
                </HintsButton>
                <Button fx:id="attachButton" graphic="$ICON_SIDEBAR" onAction="#attach" visible="false" managed="${attachButton.visible}">
                    <styleClass>
                        <String fx:value="button--transparent" />
                        <String fx:value="button--sidebar" />
                    </styleClass>
                </Button>
                <Button fx:id="detachButton" graphic="$ICON_SIDEBAR_DETACHED" onAction="#detach" managed="${detachButton.visible}">
                    <styleClass>
                        <String fx:value="button--transparent" />
                        <String fx:value="button--sidebar" />
                    </styleClass>
                </Button>
            </HBox>
            <Region fx:id="separatorSpacer" maxHeight="0" managed="${separatorSpacer.visible}"/> <!-- Spacer -->
            <AnchorPane maxWidth="Infinity" minHeight="0">
                <Separator fx:id="statusSeparator" AnchorPane.bottomAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.leftAnchor="0">
                    <styleClass>
                        <String fx:value="sidebar-group-separator"/>
                        <String fx:value="padding--horizontally-extended"/>
                    </styleClass>
                </Separator>
                <HBox fx:id="toggleButtonBar" alignment="CENTER" managed="${toggleButtonBar.visible}" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">
                    <styleClass>
                        <String fx:value="tab-button-group"/>
                        <String fx:value="spacing--none"/>
                    </styleClass>
                    <RadioToggleButton fx:id="toggleButtonBatches" text="%Batches" onAction="#showBatches" selected="true" maxWidth="Infinity" toggleGroup="$productionToggleGroup" HBox.hgrow="ALWAYS"/>
                    <RadioToggleButton fx:id="toggleButtonBlends" text="%Blends" onAction="#showBlends" maxWidth="Infinity" toggleGroup="$productionToggleGroup" HBox.hgrow="ALWAYS"/>
                </HBox>
            </AnchorPane>
        </VBox>
    </top>
    <center>
        <AnchorPane styleClass="padding-top-bottom" BorderPane.margin="$CONTENT_MARGIN">
            <VBox fx:id="productionListBox" styleClass="spacing--small" managed="${productionListBox.visible}" visible="${!controller.blendsSelected}" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">
                <HBox spacing="8" maxWidth="Infinity" alignment="CENTER_LEFT" VBox.margin="$FILTER_MARGIN">
                    <HBox fx:id="filterButtonBar" alignment="CENTER" fillHeight="false" maxWidth="Infinity" HBox.hgrow="ALWAYS">
                        <styleClass>
                            <String fx:value="toggle-button-group"/>
                            <String fx:value="spacing--none"/>
                        </styleClass>
                        <RadioToggleButton fx:id="filterButtonAll" onAction="#filterAll" selected="true" maxWidth="Infinity" styleClass="toggle-button-group__left" toggleGroup="$roastFilterGroup" HBox.hgrow="ALWAYS"/>
                        <RadioToggleButton fx:id="filterButtonScheduled" onAction="#filterScheduled" maxWidth="Infinity" styleClass="toggle-button-group__center" toggleGroup="$roastFilterGroup" HBox.hgrow="ALWAYS"/>
                        <RadioToggleButton fx:id="filterButtonRoasted" onAction="#filterRoasted" maxWidth="Infinity" styleClass="toggle-button-group__right" toggleGroup="$roastFilterGroup" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" HBox.hgrow="NEVER">
                        <Button contentDisplay="GRAPHIC_ONLY" graphic="$ICON_CUSTOMIZE" onAction="#showCustomizeInformation" AnchorPane.bottomAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0">
                            <styleClass>
                                <String fx:value="button--plain"/>
                                <String fx:value="button--small"/>
                            </styleClass>
                        </Button>
                        <Circle fx:id="customizedIndicator" radius="3" styleClass="info-dot" managed="${customizedIndicator.visible}" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0"/>
                    </AnchorPane>
                </HBox>
                <EmptyStateList fx:id="productionEmptyStateList" emptyStateMessage="%Your production is up to date" maxHeight="Infinity" VBox.vgrow="ALWAYS"/>
            </VBox>
            <EmptyStateList fx:id="blendEmptyStateList" emptyStateMessage="%No blends have been created" managed="${blendEmptyStateList.visible}" visible="${controller.blendsSelected}" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"/>
        </AnchorPane>
    </center>
    <bottom>
        <HBox styleClass="production-sidebar__status-panel">
            <Label fx:id="selectedBatchCountLabel" text="${controller.numBatchSelected}" managed="${selectedBatchCountLabel.visible}" visible="${!controller.blendsSelected}" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <Label fx:id="selectedBlendCountLabel" text="${controller.numBlendSelected}" managed="${selectedBlendCountLabel.visible}" visible="${controller.blendsSelected}" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <HBox fx:id="bulkActionBar" managed="${bulkActionBar.visible}" styleClass="hbox">
                <styleClass>
                    <String fx:value="button-bar" />
                    <String fx:value="button-bar--small" />
                </styleClass>
                <Button fx:id="batchSelectButton" text="%Select All" managed="${batchSelectButton.visible}" visible="${!controller.blendsSelected}"/>
                <Button fx:id="batchMoreButton" graphic="$ICON_SEE_MORE_BATCH" onAction="#showBatchMoreMenu" managed="${batchMoreButton.visible}" visible="${!controller.blendsSelected}"/>
                <Button fx:id="blendSelectButton" text="%Select All" managed="${blendSelectButton.visible}" visible="${controller.blendsSelected}"/>
                <Button fx:id="blendMoreButton" graphic="$ICON_SEE_MORE_BLEND" onAction="#showBlendMoreMenu" managed="${blendMoreButton.visible}" visible="${controller.blendsSelected}"/>
            </HBox>
        </HBox>
    </bottom>
</fx:root>
