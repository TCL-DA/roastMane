<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>

<fx:root type="javafx.scene.layout.BorderPane" styleClass="weight-input" xmlns:fx="http://javafx.com/fxml">
    <styleClass>
        <String fx:value="weight-input" />
        <String fx:value="weight-input--wide" />
    </styleClass>
    <!-- "id"s are used to allow TestFX robot and node finder to find components by id. -->
    <center>
        <TextField fx:id="input" id="input" styleClass="weight-input__input" />
    </center>
    <right>
        <Label text="mm:ss" id="unitLabel" styleClass="weight-input__label" BorderPane.alignment="CENTER"/>
    </right>
</fx:root>