<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import org.girod.javafx.svgimage.SVGImage?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>
<?import com.cropster.roastingintelligence.ui.components.FormComponent?>
<?import com.cropster.roastingintelligence.ui.components.LineBreak?>
<?import com.cropster.roastingintelligence.ui.components.MeasureEditor?>
<?import com.cropster.roastingintelligence.ui.components.MessageBox?>
<?import com.cropster.roastingintelligence.ui.components.WebLink?>
<?import com.cropster.roastingintelligence.ui.util.AutoIncIndex?>

<fx:root type="GridPane" styleClass="grid-pane" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml">
    <fx:define>
        <AutoIncIndex fx:id="row"/>
        <AutoIncIndex fx:id="predictionsRow"/>
        <AutoIncIndex fx:id="alertsRow"/>
        <Insets fx:id="PROMO_MESSAGE_MARGIN" top="8"/>
        <SVGImage fx:id="ICON_TIP" icon="TIP" styleClass="icon--muted"/>
        <SVGImage fx:id="ICON_RESET" icon="RESET"/>
        <SVGImage fx:id="ICON_VOLUME_HIGH" icon="VOLUME_HIGH"/>
        <ToggleGroup fx:id="autoStartToggleGroup"/>
    </fx:define>
    <columnConstraints>
        <ColumnConstraints halignment="LEFT" hgrow="ALWAYS" fillWidth="true"/>
    </columnConstraints>

    <FormComponent title="%Smart predictions" GridPane.rowIndex="$row.idx">
        <description>
            <Text text="%First crack prediction and gas measurement need to be enabled in order for the flick prediction to work. A flick can be influenced by gas management around the first crack."/>
            <LineBreak/>
            <WebLink text="%Find out more in this manual." url="https://help.cropster.com/en/knowledge/using-smart-predictions"/>
        </description>
        <GridPane vgap="8.0">
            <columnConstraints>
                <ColumnConstraints halignment="LEFT" hgrow="ALWAYS" fillWidth="true"/>
            </columnConstraints>
            <rowConstraints>
                <RowConstraints valignment="TOP" vgrow="NEVER" fillHeight="true"/>
            </rowConstraints>
            <FormComponent note="%The prediction starts at least 2 minutes into the roast and predicts curves for the upcoming 2 minutes." maxWidth="Infinity" GridPane.rowIndex="$predictionsRow.idx">
                <CheckBox fx:id="curvePredictionCheckbox" text="%Bean temperature and RoR prediction curves"/>
            </FormComponent>
            <FormComponent note="%Appears ~3 minutes before first crack." maxWidth="Infinity" GridPane.rowIndex="$predictionsRow.inc">
                <CheckBox fx:id="firstCrackPredictionCheckbox" text="%First crack prediction"/>
            </FormComponent>
            <FormComponent maxWidth="Infinity" GridPane.rowIndex="$predictionsRow.inc">
                <notes>
                    <Text text="%The first crack prediction needs to be enabled for the flick prediction to work. The flick prediction appears ~2 minutes before first crack." styleClass="hint"/>
                    <Text text=" " styleClass="hint"/>
                    <WebLink text="%Find out more in this manual." url="https://help.cropster.com/en/knowledge/how-to-use-flick-prediction" styleClass="web-hint"/>
                </notes>
                <CheckBox fx:id="flickPredictionCheckbox" text="%Flick prediction" styleClass="always-enabled"/>
            </FormComponent>
        </GridPane>
    </FormComponent>

    <Separator styleClass="preferences-separator" GridPane.rowIndex="$row.inc"/>

    <FormComponent title="%Smart replay" note="%Use it to reproduce profiles recorded with slider controls. You can always take charge at any moment by turning the replay off." GridPane.rowIndex="$row.inc">
        <CheckBox fx:id="replayEnabledCheckbox" text="%Enable replay feature"/>
    </FormComponent>

    <Separator styleClass="preferences-separator" GridPane.rowIndex="$row.inc"/>

    <FormComponent title="%Smart alerts" GridPane.rowIndex="$row.inc">
        <BorderPane>
            <top>
                <VBox styleClass="spacing--small">
                    <CheckBox fx:id="smartAlertsCheckbox" text="%Enable the use of alerts to get informed about specific events" onAction="#enableSmartAlerts"/>
                    <HBox fx:id="enableNotificationContainer" styleClass="spacing--none" alignment="CENTER_LEFT" VBox.vgrow="NEVER" managed="${enableNotificationContainer.visible}" visible="${smartAlertsCheckbox.selected}">
                        <Pane styleClass="square-space--medium"/>
                        <CheckBox fx:id="enableNotificationCheckbox" text="%Display triggered alerts with in-app notifications"/>
                    </HBox>
                </VBox>
            </top>
            <center>
                <GridPane fx:id="hidableContainer" managed="${hidableContainer.visible}" visible="${smartAlertsCheckbox.selected}">
                    <styleClass>
                        <String fx:value="grid-pane--compact"/>
                        <String fx:value="padding-top"/>
                    </styleClass>
                    <columnConstraints>
                        <ColumnConstraints halignment="LEFT" hgrow="ALWAYS" fillWidth="true"/>
                    </columnConstraints>
                    <FormComponent fx:id="alertsSoundRepetitionForm" title="%Alerts sound repetition" maxWidth="Infinity" GridPane.rowIndex="$alertsRow.idx">
                        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="padding-bottom--small">
                            <Label text="%Number of repeats for an alert sound"/>
                            <MeasureEditor fx:id="repetitionEditor" fractionEnabled="false" prefHeight="24" styleClass="weight-input--no-unit"/>
                        </HBox>
                    </FormComponent>
                    <FormComponent fx:id="alertsVolumeForm" title="%Alerts volume" note="%Adjust the alert volume if it should be different from your system." maxWidth="Infinity" GridPane.rowIndex="$alertsRow.inc">
                        <HBox alignment="CENTER_LEFT" spacing="16" maxWidth="Infinity">
                            <Slider fx:id="volumeSlider" HBox.hgrow="ALWAYS"/>
                            <MeasureEditor fx:id="volumeEditor" prefHeight="24"/>
                            <Button fx:id="volumeTestButton" graphic="$ICON_VOLUME_HIGH" text="%Test" onAction="#testVolume"/>
                        </HBox>
                    </FormComponent>
                </GridPane>
            </center>
        </BorderPane>
    </FormComponent>

    <Separator styleClass="preferences-separator" GridPane.rowIndex="$row.inc"/>

    <FormComponent fx:id="smartGoalsAndReferencesForm" title="%Smart goals" GridPane.rowIndex="$row.inc">
        <description>
            <Text text="%Visualize your reference parameters and goals at all times in the “Parameters and goals” box — and get live feedback as your web-configured goals are met or missed."/>
        </description>
        <VBox styleClass="spacing--default">
            <CheckBox fx:id="smartGoalsAndReferencesEnabledCheckBox" text="%Enable the use of “Parameters and goals” box"/>
            <HBox fx:id="enableSmartGoalContainer" styleClass="spacing--none" alignment="CENTER_LEFT" VBox.vgrow="NEVER" managed="${enableSmartGoalContainer.visible}" visible="${smartGoalsAndReferencesEnabledCheckBox.selected}">
                <Pane styleClass="square-space--medium"/>
                <VBox styleClass="spacing--large">
                    <FormComponent note="%Only display reference values and (if applicable) smart goal ranges.">
                        <CheckBox fx:id="hideLiveGoalCurrentValueCheckBox" text="%Hide current value on each box"/>
                    </FormComponent>
                    <CheckBox fx:id="hideGoalStatisticsCheckBox" text="%Hide parameters and goals from the Reference overview"/>
                </VBox>
            </HBox>
            <MessageBox fx:id="smartGoalsPromo" text="%Professional subscription required for smart goals. &lt;b&gt;Talk with your account manager to know more benefits of upgrading&lt;/b&gt;" graphic="$ICON_TIP" styleClass="info-message--neutral" managed="${smartGoalsPromo.visible}" VBox.margin="$PROMO_MESSAGE_MARGIN"/>
        </VBox>
    </FormComponent>

    <Separator styleClass="preferences-separator" GridPane.rowIndex="$row.inc"/>

    <FormComponent title="%Smart roast completed" note="%Use the Replay button to replicate a roast by following the profile’s slider control changes. This feature resets the slider controls to the starting setting of a profile at the end of the roast cycle after the selected delay." GridPane.rowIndex="$row.inc">
        <HBox alignment="CENTER_LEFT" spacing="8">
            <CheckBox fx:id="resetGasThresholdCheckbox" text="Reset profile slider controls settings at end of roast cycle after"/>
            <MeasureEditor fx:id="resetGasThresholdField" styleClass="weight-input" unit="SECOND" disable="${!resetGasThresholdCheckbox.selected}"/>
        </HBox>
    </FormComponent>

    <Separator styleClass="preferences-separator" GridPane.rowIndex="$row.inc"/>

    <FormComponent title="%Smart detection" GridPane.rowIndex="$row.inc">
        <GridPane fx:id="smartDetectionAutoStartPanel" hgap="8.0" vgap="8.0">
            <columnConstraints>
                <ColumnConstraints minWidth="10" maxWidth="10" />
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>
            <CheckBox fx:id="startEndCheckbox" text="%Start and end of a roast" GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.columnSpan="2" />
            <RadioButton fx:id="autoStartRadiobutton" text="Machine event-based auto-start and end of roast" wrapText="true" toggleGroup="$autoStartToggleGroup" styleClass="always-enabled" GridPane.rowIndex="1" GridPane.columnIndex="1" />
            <TextFlow styleClass="hint" GridPane.rowIndex="2" GridPane.columnIndex="1">
                <Text fx:id="autoStartDescription" styleClass="hint" text="Machine events differ between manufacturers and machine types. Wondering which events can trigger the auto-start and end of a roast for your machine?"/>
                <Text managed="${autoStartLink.visible}" text=" " styleClass="hint"/>
                <WebLink fx:id="autoStartLink" managed="${autoStartLink.visible}" text="%Find out more in this manual." url="https://help.cropster.com/en/knowledge/how-does-machine-event-based-auto-start-and-end-detection-work" styleClass="web-hint"/>
            </TextFlow>
            <FormComponent note="%Temperature drop required to trigger these events. To detect the start the threshold has to be reached within 30 seconds, for the end within 5 seconds." GridPane.rowIndex="3" GridPane.columnIndex="1" >
                <RadioButton fx:id="autoDetectionRadiobutton" text="%Temperature-based auto-start and end of roast" toggleGroup="$autoStartToggleGroup" styleClass="always-enabled" />
            </FormComponent>
            <VBox fx:id="thresholdFieldAutoStartPane" GridPane.rowIndex="5" GridPane.columnIndex="1">
                <GridPane hgap="8.0" vgap="8.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES"/>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="104"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints vgrow="NEVER"/>
                    </rowConstraints>
                    <Label text="%Detect start when temperature drops by" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <MeasureEditor fx:id="startThresholdField" styleClass="always-enabled" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label text="%Detect end when temperature drops by" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <MeasureEditor fx:id="endThresholdField" styleClass="always-enabled" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Button fx:id="resetThresholdButton" graphic="$ICON_RESET" text="%Reset temperatures" onAction="#resetThresholds" styleClass="always-enabled" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="3"/>
                </GridPane>
            </VBox>
        </GridPane>
        <VBox fx:id="smartDetectionNoAutoStartPanel">
            <FormComponent note="%Temperature drop required to trigger these events. To detect the start the threshold has to be reached within 30 seconds, for the end within 5 seconds.">
                <CheckBox fx:id="autoDetectionCheckbox" text="%Temperature-based auto-start and end of roast"/>
            </FormComponent>
            <VBox fx:id="thresholdFieldNoAutoStartPane"/>
        </VBox>
    </FormComponent>
</fx:root>
