<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.cropster.roastingintelligence.model.*?>
<?import com.cropster.roastingintelligence.ui.components.FormComponent?>
<?import com.cropster.roastingintelligence.ui.components.RadioToggleButton?>

<fx:root type="VBox" styleClass="basic-list-cell" xmlns:fx="http://javafx.com/fxml">
    <fx:define>
		<Insets fx:id="HEADER_MARGIN" top="12" right="12" bottom="12" left="12"/>
        <ToggleGroup fx:id="statusToggleGroup" />
        <WorkerTask.TaskStatus fx:id="DONE" fx:constant="DONE" />
        <WorkerTask.TaskStatus fx:id="NOT_DONE" fx:constant="NOT_DONE" />
    </fx:define>

	<HBox styleClass="basic-list-cell--header" VBox.margin="$HEADER_MARGIN">
		<Label fx:id="titleLabel" maxWidth="Infinity" styleClass="header-title--bold" HBox.hgrow="ALWAYS"/>
		<Button fx:id="cancelButton" text="%Cancel" styleClass="button--plain" minWidth="-Infinity" HBox.hgrow="NEVER"/>
		<Button fx:id="saveButton" text="%Save" styleClass="button--primary" minWidth="-Infinity" HBox.hgrow="NEVER"/>
	</HBox>

	<Separator fx:id="headerSeparator"/>

	<VBox maxWidth="Infinity" styleClass="basic-list-cell--editor-body">
		<FormComponent fx:id="eventFormButtonsBar" title="%Marked as" maxWidth="Infinity" HBox.hgrow="ALWAYS">
			<HBox maxWidth="Infinity" HBox.hgrow="ALWAYS">
				<styleClass>
					<String fx:value="toggle-button-group"/>
					<String fx:value="spacing--none"/>
				</styleClass>
				<RadioToggleButton userData="$DONE" text="%Done" toggleGroup="$statusToggleGroup" selected="true" styleClass="translate-userdata" focusTraversable="false" minHeight="32" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
				<RadioToggleButton userData="$NOT_DONE" text="%Won't do" toggleGroup="$statusToggleGroup" styleClass="translate-userdata" minHeight="32" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
			</HBox>
		</FormComponent>
		<FormComponent title="%Notes" maxHeight="80" maxWidth="Infinity" HBox.hgrow="ALWAYS">
			<decorations>
				<Label fx:id="availableChars" text="250" styleClass="comment-under-limit"/>
			</decorations>
            <TextArea fx:id="commentField" wrapText="true" promptText="%Type something…"/>
		</FormComponent>
	</VBox>
</fx:root>
