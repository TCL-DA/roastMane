<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>

<fx:root type="javafx.scene.layout.HBox" alignment="CENTER" xmlns:fx="http://javafx.com/fxml">
    <fx:define>
        <Region fx:id="USE_PREF_SIZE" fx:constant="USE_PREF_SIZE" />
    </fx:define>
    <styleClass>
        <String fx:value="toggle-switch" />
        <String fx:value="toggle-switch--off" />
    </styleClass>
    <Label fx:id="textLabel" minWidth="$USE_PREF_SIZE" text="${controller.text}" styleClass="toggle-switch__label" />
    <Pane fx:id="switcher" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" styleClass="toggle-switch__toggle-wrapper">
        <Label styleClass="toggle-switch__toggle" />
    </Pane>
</fx:root>