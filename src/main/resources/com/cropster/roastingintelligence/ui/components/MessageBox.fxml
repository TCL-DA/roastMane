<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<fx:root type="javafx.scene.layout.HBox" alignment="TOP_LEFT" fillHeight="false" xmlns:fx="http://javafx.com/fxml">
    <styleClass>
        <String fx:value="info-message"/>
        <String fx:value="info-message--info"/>
    </styleClass>
    <Label fx:id="iconLabel" styleClass="info-message__icon" managed="${iconLabel.visible}"/>
    <VBox fx:id="messageWrapper" styleClass="info-message__content-wrapper" HBox.hgrow="ALWAYS">
        <Text fx:id="header" styleClass="info-message__title" visible="false" managed="false"/>
        <TextFlow fx:id="contents" styleClass="info-message__content"/>
    </VBox>
</fx:root>