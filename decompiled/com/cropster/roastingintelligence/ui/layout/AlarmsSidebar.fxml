<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import org.girod.javafx.svgimage.SVGImage?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.input.KeyCodeCombination?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import com.cropster.roastingintelligence.ui.components.HintsButton?>
<?import com.cropster.roastingintelligence.ui.components.HintsFooterElement?>
<?import com.cropster.roastingintelligence.ui.components.KeyCodeCombinationLabel?>
<?import com.cropster.roastingintelligence.ui.components.LineBreak?>
<?import com.cropster.roastingintelligence.ui.components.RadioToggleButton?>
<?import com.cropster.roastingintelligence.ui.components.Tooltip?>
<?import com.cropster.roastingintelligence.ui.list.EmptyStateList?>

<fx:root type="BorderPane" styleClass="pane--elevated" xmlns:fx="http://javafx.com/fxml">
    <fx:define>
        <Insets fx:id="CONTENT_MARGIN" top="-8"/>
        <Insets fx:id="FILTER_MARGIN" right="9.5" left="9.5"/>
        <SVGImage fx:id="ICON_FOOTER_ADD" icon="ADD"/>
        <SVGImage fx:id="ICON_FOOTER_CLEAN" icon="CLEAN"/>
        <SVGImage fx:id="ICON_HINT_ADD" icon="ADD"/>
        <SVGImage fx:id="ICON_HINT_CLEAN" icon="CLEAN"/>
        <SVGImage fx:id="ICON_SIDEBAR" icon="SIDEBAR"/>
        <SVGImage fx:id="ICON_SIDEBAR_DETACHED" icon="SIDEBAR_DETACHED"/>
        <ToggleGroup fx:id="alarmsToggleGroup"/>
        <ToggleGroup fx:id="alarmsFilterGroup"/>
    </fx:define>
    <top>
        <VBox fx:id="headerBox">
            <styleClass>
                <String fx:value="padding-sides--small"/>
                <String fx:value="spacing--default"/>
            </styleClass>
            <HBox alignment="CENTER_LEFT" styleClass="spacing--small">
                <Label text="${controller.title}" maxWidth="Infinity" styleClass="heading" HBox.hgrow="ALWAYS">
                    <tooltip>
                        <Tooltip text="${controller.title}"/>
                    </tooltip>
                </Label>
                <HintsButton arrowLocation="LEFT_TOP" small="true" title="%About this sidebar">
                    <Text text="%Create your own alerts and get informed when desired conditions are met, through visual chart highlights, chosen sounds, and even in-app notifications."/>
                    <LineBreak/>
                    <LineBreak/>
                    <Text text="%Enable or disable alerts using the toggle switch, or simply delete them."/>
                    <LineBreak/>
                    <LineBreak/>
                    <Text text="%In-app notifications won’t be displayed if the alerts log is open on its sidebar."/>
                    <footer>
                        <Label styleClass="hints-footer-title" text="%Actions, usage and keyboard shortcuts"/>
                        <KeyCodeCombinationLabel fx:id="keyCodeCombinationLabel" text="%Dismiss a triggered alert">
                            <keyCodeCombination>
                                <KeyCodeCombination code="ESCAPE" shift="UP" control="UP" alt="UP" meta="UP" shortcut="UP"/>
                            </keyCodeCombination>
                        </KeyCodeCombinationLabel>
                        <HintsFooterElement description="%Add new alert" element="%Add" elementGraphic="$ICON_HINT_ADD"/>
                        <HintsFooterElement description="%Clear triggered alerts" element="%Clear" elementGraphic="$ICON_HINT_CLEAN"/>
                    </footer>
                </HintsButton>
                <Button fx:id="attachButton" graphic="$ICON_SIDEBAR" onAction="#attach" visible="false" managed="${attachButton.visible}">
                    <styleClass>
                        <String fx:value="button--transparent"/>
                        <String fx:value="button--small"/>
                    </styleClass>
                </Button>
                <Button fx:id="detachButton" graphic="$ICON_SIDEBAR_DETACHED" onAction="#detach" managed="${detachButton.visible}">
                    <styleClass>
                        <String fx:value="button--transparent"/>
                        <String fx:value="button--small"/>
                    </styleClass>
                </Button>
            </HBox>
            <AnchorPane maxWidth="Infinity">
                <Separator fx:id="statusSeparator" AnchorPane.bottomAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.leftAnchor="0">
                    <styleClass>
                        <String fx:value="sidebar-group-separator"/>
                        <String fx:value="padding--horizontally-extended"/>
                    </styleClass>
                </Separator>
                <HBox fx:id="toggleButtonBar" alignment="CENTER" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">
                    <styleClass>
                        <String fx:value="tab-button-group"/>
                        <String fx:value="spacing--none"/>
                    </styleClass>
                    <RadioToggleButton fx:id="toggleButtonAlarmsLog" text="%Log" onAction="#showAlarmsLog" maxWidth="Infinity" toggleGroup="$alarmsToggleGroup" HBox.hgrow="ALWAYS"/>
                    <RadioToggleButton fx:id="toggleButtonAlarmsManage" text="%Manage" onAction="#showAlarmsManage" selected="true" maxWidth="Infinity" toggleGroup="$alarmsToggleGroup" HBox.hgrow="ALWAYS"/>
                </HBox>
            </AnchorPane>
        </VBox>
    </top>
    <center>
        <AnchorPane styleClass="padding-top-bottom" BorderPane.margin="$CONTENT_MARGIN">
            <VBox fx:id="alarmsListBox" styleClass="spacing--small" managed="${alarmsListBox.visible}" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0">
                <HBox fx:id="filterButtonBar" alignment="CENTER" VBox.margin="$FILTER_MARGIN">
                    <styleClass>
                        <String fx:value="toggle-button-group"/>
                        <String fx:value="spacing--none"/>
                    </styleClass>
                    <RadioToggleButton fx:id="filterButtonAll" text="%All" onAction="#filterAll" selected="true" maxWidth="Infinity" toggleGroup="$alarmsFilterGroup" HBox.hgrow="ALWAYS"/>
                    <RadioToggleButton fx:id="filterButtonMeasurements" text="%Temp." onAction="#filterMeasurements" maxWidth="Infinity" toggleGroup="$alarmsFilterGroup" HBox.hgrow="ALWAYS"/>
                    <RadioToggleButton fx:id="filterButtonEvents" text="%Events" onAction="#filterEvents" maxWidth="Infinity" toggleGroup="$alarmsFilterGroup" HBox.hgrow="ALWAYS"/>
                    <RadioToggleButton fx:id="filterButtonTime" text="%Time" onAction="#filterTime" maxWidth="Infinity" toggleGroup="$alarmsFilterGroup" HBox.hgrow="ALWAYS"/>
                </HBox>
                <EmptyStateList fx:id="alarmEmptyStateList" emptyStateMessage="%No alerts have been created" maxHeight="Infinity" VBox.vgrow="ALWAYS"/>
            </VBox>
            <EmptyStateList fx:id="triggeredAlarmEmptyStateList" emptyStateMessage="%No alerts have been triggered" managed="${triggeredAlarmEmptyStateList.visible}" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"/>
        </AnchorPane>
    </center>
    <bottom>
        <HBox fx:id="footerPanel" styleClass="sidebar-footer" maxWidth="Infinity" alignment="CENTER_LEFT">
            <Label fx:id="footerLabel" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            <HBox styleClass="hbox">
                <styleClass>
                    <String fx:value="button-bar"/>
                    <String fx:value="button-bar--small"/>
                </styleClass>
                <Button fx:id="clearButton" mnemonicParsing="false" text="%Clear" graphic="$ICON_FOOTER_CLEAN" managed="${clearButton.visible}" visible="false"/>
                <Button fx:id="addButton" mnemonicParsing="false" text="%Add" graphic="$ICON_FOOTER_ADD" managed="${addButton.visible}" visible="false"/>
            </HBox>
        </HBox>
    </bottom>
</fx:root>
