<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import com.cropster.roastingintelligence.ui.components.RandomShortcutPane?>

<fx:root type="StackPane" styleClass="padding-top--small" alignment="TOP_LEFT" xmlns:fx="http://javafx.com/fxml">
    <fx:define>
        <Insets fx:id="MESSAGE_MARGIN" top="16"/>
    </fx:define>
    <VBox fx:id="infoBox" styleClass="spacing--large" alignment="TOP_CENTER" managed="${infoBox.visible}" StackPane.margin="$MESSAGE_MARGIN">
        <Label fx:id="emptyStateLabel" styleClass="input-label" wrapText="true" textAlignment="CENTER" alignment="CENTER"/>
        <Label fx:id="emptyStateNote" managed="${emptyStateNote.visible}" wrapText="true" alignment="CENTER"/>
        <RandomShortcutPane fx:id="randomShortcutPane" managed="${randomShortcutPane.visible}"/>
    </VBox>
    <ScrollPane fx:id="listViewScroller" fitToWidth="true" fitToHeight="true" visible="${!infoBox.visible}">
        <ListView fx:id="listView" styleClass="transparent-list"/>
    </ScrollPane>
</fx:root>
